# OpenAI
OPENAI_API_KEY=

# Optional local defaults. If empty, the script looks in ~/Downloads for the
# two files used by the current test case.
MODEL_IMAGE_PATH=
BASE_VIDEO_PATH=
GARMENT_DIR=

# Gemini backend: vertex uses the GCP trial credit; ai_studio uses a Gemini API key.
GEMINI_BACKEND=vertex

# Google Cloud Agent Platform (required when GEMINI_BACKEND=vertex)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Optional bucket for Vertex video-edit inputs; useful for large local videos.
GEMINI_GCS_BUCKET=

# Gemini Developer API (required only when GEMINI_BACKEND=ai_studio)
GEMINI_API_KEY=

# Optional narration and subtitles
OPENAI_TEXT_MODEL=gpt-4o
FISH_AUDIO_API_KEY=
FISH_AUDIO_MODEL=s2.1-pro-free
FISH_AUDIO_VOICE_ID=
FISH_AUDIO_API_URL=https://api.fish.audio/v1/tts
# Compatibility aliases for older configurations:
FISH_API_KEY=
FISH_REFERENCE_ID=
FISH_MODEL=
FISH_TTS_URL=
GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GROQ_LANGUAGE=es
CAPTION_FONT=
CAPTION_MAX_WORDS=4
CAPTION_POSITION=top
FISH_AUDIO_TIMEOUT_SECONDS=900
FISH_TIMEOUT_SECONDS=900

# Knasta: solo lee páginas públicas de resultados y filtra fichas oficiales de Falabella.
KNASTA_ENABLED=false
KNASTA_SEARCH_TERMS=poleron,polera,jeans,chaqueta,vestido
KNASTA_MIN_DISCOUNT_PERCENT=30
KNASTA_MAX_OFFERS=5
KNASTA_MAX_RESULTS_PER_TERM=40
KNASTA_REQUEST_DELAY_SECONDS=2
KNASTA_RESPECT_ROBOTS=true
KNASTA_COMMENT_KEYWORD=LOOK

# Instagram Graph API
# Use the API host that matches the Instagram login flow in your Meta app.
META_GRAPH_BASE_URL=https://graph.instagram.com
# Keep this aligned with the version enabled by your Meta app.
META_API_VERSION=v23.0
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# Cloudinary: se usa automáticamente como URL pública cuando ejecutas --publish.
# No compartas este valor: contiene API key y API secret.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_TIMEOUT_SECONDS=600

# The video must be hosted at a public HTTPS URL before Instagram can fetch it.
# Leave empty when you only want to generate local files.
INSTAGRAM_VIDEO_URL=
INSTAGRAM_CAPTION="Mira el outfit completo en el enlace."
AFFILIATE_DISCLOSURE="Enlace de afiliado: puedo recibir una comisión si compras."
ORGANIC_DISCLOSURE="Contenido de prueba generado con IA. Verifica precio y stock en la tienda."

# TikTok Content Posting API (optional; use --publish-tiktok or --publish-both)
TIKTOK_ACCESS_TOKEN=
TIKTOK_VIDEO_URL=
TIKTOK_TITLE=
TIKTOK_PRIVACY_LEVEL=PUBLIC_TO_EVERYONE
TIKTOK_COVER_TIMESTAMP_MS=1000
TIKTOK_DISABLE_DUET=false
TIKTOK_DISABLE_COMMENT=false
TIKTOK_DISABLE_STITCH=false
TIKTOK_POLL_SECONDS=10
TIKTOK_TIMEOUT_SECONDS=600

# Leave GEMINI_VIDEO_PROMPT empty to use the detailed built-in prompt.
GEMINI_VIDEO_PROMPT=
GEMINI_ASPECT_RATIO=9:16
GEMINI_VIDEO_DURATION=10s

# Polling and timeout settings
GEMINI_POLL_SECONDS=5
GEMINI_TIMEOUT_SECONDS=1200
INSTAGRAM_POLL_SECONDS=10
INSTAGRAM_TIMEOUT_SECONDS=600
