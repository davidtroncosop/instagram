# OpenAI
OPENAI_API_KEY=

# Google Gemini API
GEMINI_API_KEY=

# Instagram Graph API
# Use the API host that matches the Instagram login flow in your Meta app.
META_GRAPH_BASE_URL=https://graph.instagram.com
# Keep this aligned with the version enabled by your Meta app.
META_API_VERSION=v23.0
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# The video must be hosted at a public HTTPS URL before Instagram can fetch it.
# Leave empty when you only want to generate local files.
INSTAGRAM_VIDEO_URL=
INSTAGRAM_CAPTION="Mira el outfit completo en el enlace."
AFFILIATE_DISCLOSURE="Enlace de afiliado: puedo recibir una comisión si compras."

# Polling and timeout settings
GEMINI_POLL_SECONDS=5
GEMINI_TIMEOUT_SECONDS=1200
INSTAGRAM_POLL_SECONDS=10
INSTAGRAM_TIMEOUT_SECONDS=600
